# Docker Compose dotenv syntax. Shell environment values take precedence.
IMAGE=eugr/spark-vllm-b12x:latest
HF_TOKEN=
# Optional API authentication. Empty means anyone who can reach the port can use it.
API_KEY=
BIND=0.0.0.0
PORT=8888

# NVIDIA's published DGX Spark defaults.
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=4096
GPU_MEMORY_UTILIZATION=0.8

# Optional absolute host cache paths; defaults reuse NVIDIA's original recipe.
# HF_CACHE=/mnt/nvme/huggingface
# VLLM_CACHE=/mnt/nvme/vllm
# FLASHINFER_CACHE=/mnt/nvme/flashinfer
# TRITON_CACHE=/mnt/nvme/triton
# B12X_CACHE=/mnt/nvme/b12x
